+static bool vrend_can_emulate_render_condition(void)
+{
+   return vrend_state.use_gles && has_feature(feat_occlusion_query_boolean);
+}
+
+static bool vrend_emulated_render_condition_passes(const struct vrend_query *q, GLenum mode)
+{
+   GLuint result = GL_TRUE;
+
+   if (q->gltype != GL_ANY_SAMPLES_PASSED &&
+       q->gltype != GL_ANY_SAMPLES_PASSED_CONSERVATIVE &&
+       q->gltype != GL_SAMPLES_PASSED)
+      return true;
+
+   /* GLES has occlusion queries but generally lacks conditional rendering.
+    * A region query may use the whole framebuffer result. A no-wait query
+    * whose result is still pending is allowed to render unconditionally. */
+   if (mode == GL_QUERY_NO_WAIT || mode == GL_QUERY_BY_REGION_NO_WAIT) {
+      GLuint ready = GL_FALSE;
+      glGetQueryObjectuiv(q->id, GL_QUERY_RESULT_AVAILABLE, &ready);
+      if (!ready)
+         return true;
+   }
+
+   glGetQueryObjectuiv(q->id, GL_QUERY_RESULT, &result);
+   return result != 0;
+}
